# FullStory API credentials
FULLSTORY_API_KEY=your_api_key_here
FULLSTORY_ORG_ID=your_org_id_here

# The custom user property name used for applicationId in FullStory
# This must match the key used in FS.identify() or FS.setUserVars()
# e.g. if you called: FS.identify(uid, { applicationId: "abc" }) → set this to "applicationId"
FS_APPLICATION_ID_FIELD=applicationId

# Where to save the final MP4 files
OUTPUT_DIR=C:\recordings

# Max sessions to process per applicationId (default: 10)
MAX_SESSIONS_PER_APP=10
