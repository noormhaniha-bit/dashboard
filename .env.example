# Copy to .env and point this at the folder that already contains the generated SLA PDFs
# (the output_dir from multi_lender_config.ini, e.g. .../ReportsExecute/sla_reports_output).
# Expected layout: REPORTS_ROOT_DIR/<Lender>/<YYYY-MM>/*.pdf
REPORTS_ROOT_DIR=C:\path\to\sla_reports_output

HOST=127.0.0.1
PORT=8000

# Read-only connection to the ConsumerFinancing analytics replica.
# Leave ANALYTICS_DB_HOST blank to run with the Analytics tab disabled (PDF viewer still
# works standalone).
ANALYTICS_DB_HOST=
ANALYTICS_DB_PORT=1433
ANALYTICS_DB_NAME=ConsumerFinancing_Replica

# Windows Authentication -- set to true to log into SQL Server as whichever Windows account
# runs this process (no SQL login/password needed or used). This is what you want if your
# DB host only accepts Windows Auth. Leave false to use a SQL Server login instead.
ANALYTICS_DB_TRUSTED_CONNECTION=true

# Only used when ANALYTICS_DB_TRUSTED_CONNECTION=false.
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=

# Check which ODBC drivers are actually installed on this machine with:
#   python -c "import pyodbc; print(pyodbc.drivers())"
# and set this to match -- don't assume 17 vs 18, they're not interchangeable.
ANALYTICS_DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Login sessions ---
# Required before letting anyone but you use this. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank the app runs with an insecure hardcoded default and logs a warning --
# fine for a quick local test, not for teammates actually logging in.
SESSION_SECRET_KEY=
SESSION_MAX_AGE_HOURS=12
# Set to true once this runs behind HTTPS (e.g. a reverse proxy) -- keep false on
# localhost/plain HTTP or the login cookie will never be sent back.
SESSION_COOKIE_SECURE=false
